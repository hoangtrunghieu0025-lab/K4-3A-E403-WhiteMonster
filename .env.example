# Soát kịch bản — dùng key đầu tiên có giá trị theo thứ tự: OpenAI → OpenCode Go → Gemini
OPENAI_API_KEY=
# OpenCode Go: endpoint tương thích OpenAI; đổi model bằng OPENCODE_MODEL (vd kimi-k3, glm-5.3)
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash
# Gemini: soát khi không có 2 key trên (gemini-3.6-flash, đổi bằng GEMINI_MODEL).
# "Xem chữ máy đọc" luôn dùng key này để chép lại audio.
# Giọng nghe thử luôn là Piper chạy trên máy, không cần key.
GEMINI_API_KEY=
